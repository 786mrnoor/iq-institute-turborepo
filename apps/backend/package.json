{
	"name": "backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./src/app.ts",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/server.ts",
		"build": "tsdown src/app.ts --format esm",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome lint .",
		"format": "biome check --write",
		"format:check": "biome format .",
		"typecheck": "tsc --noEmit",
		"check": "biome check . && tsc --noEmit"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"cookie-parser": "^1.4.7",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"mongoose": "^9.9.4",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@repo/schemas": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@repo/utils": "workspace:*",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.4.0",
		"@types/supertest": "^7.2.1",
		"dotenv": "^18.0.5",
		"mongodb-memory-server": "^11.3.0",
		"supertest": "^7.3.1",
		"tsc-alias": "^1.9.2",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.13",
		"turbo": "^2.10.12",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.3.4",
			"onFail": "download"
		}
	}
}
