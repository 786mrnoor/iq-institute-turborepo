{
	"name": "backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./src/app.ts",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/app.ts",
		"build": "tsc && tsc-alias",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "tsc --noEmit",
		"check": "biome check . && tsc --noEmit"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"cookie-parser": "^1.4.7",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"mongoose": "^9.9.4",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@repo/utils": "workspace:*",
		"@repo/schemas": "workspace:*",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.4.0",
		"tsc-alias": "^1.9.2",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2"
	}
}
