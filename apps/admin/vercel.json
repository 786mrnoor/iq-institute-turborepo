{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"rewrites": [
		{
			"source": "/admin/assets/(.*)",
			"destination": "/assets/$1"
		},
		{
			"source": "/admin",
			"destination": "/index.html"
		},
		{
			"source": "/admin/:path*",
			"destination": "/index.html"
		}
	],
	"headers": [
		{
			"source": "/admin/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
